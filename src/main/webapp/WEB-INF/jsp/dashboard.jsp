<%@ page pageEncoding="UTF-8" %>
<%@ include file="_top.jspf" %>
<section class="dashboard-heading"><div><p class="eyebrow">YOUR MONTH AT A GLANCE</p><h1><c:out value="${summary.profile.displayName}"/>'s planner</h1><p class="muted">Give every part of your income a purpose with 50/30/20.</p></div><form class="month-form" method="get" action="<c:url value='/'/>"><label for="month">Planning month</label><div><input type="month" id="month" name="month" value="<c:out value='${month}'/>" min="0001-01" max="9999-12" required><button class="secondary" type="submit">Open month</button></div></form></section>
<section class="income-strip"><div><p class="eyebrow">MONTHLY TAKE-HOME INCOME</p><strong class="income-value"><fmt:formatNumber value="${summary.budget.income}" type="currency"/></strong><p class="muted">After taxes and other payroll deductions.</p></div><form method="post" action="<c:url value='/income'/>"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="formProfileId" value="<c:out value='${summary.profile.id}'/>"><input type="hidden" name="month" value="<c:out value='${month}'/>"><label for="income">Update income ($)</label><div class="inline"><input type="number" name="income" id="income" min="0" max="999999999.99" step="0.01" required value="<c:out value='${incomeInput}'/>"><button type="submit">Save income</button></div></form></section>
<div class="category-grid"><c:forEach items="${summary.categories}" var="cat"><section class="category-card <c:out value='${cat.category}'/>"><div class="card-heading"><h2><c:choose><c:when test="${cat.category eq 'NEEDS'}">Needs</c:when><c:when test="${cat.category eq 'WANTS'}">Wants</c:when><c:otherwise>Goals</c:otherwise></c:choose></h2><span class="badge"><c:choose><c:when test="${cat.category eq 'NEEDS'}">50%</c:when><c:when test="${cat.category eq 'WANTS'}">30%</c:when><c:otherwise>20%</c:otherwise></c:choose></span></div>
<p class="target"><fmt:formatNumber value="${cat.target}" type="currency"/><span>monthly target</span></p><progress max="100" value="${cat.progressPercent}" aria-label="<c:out value='${cat.category}'/> target progress">${cat.progressPercent}%</progress>
<div class="card-stat"><span><c:choose><c:when test="${cat.category eq 'GOALS'}">Contributed</c:when><c:otherwise>Spent</c:otherwise></c:choose></span><strong><fmt:formatNumber value="${cat.actual}" type="currency"/></strong></div>
<div class="card-stat"><c:choose><c:when test="${cat.remaining lt 0}"><span><c:choose><c:when test="${cat.category eq 'GOALS'}">Goal exceeded by</c:when><c:otherwise>Above target by</c:otherwise></c:choose></span><strong class="<c:if test="${cat.category ne 'GOALS'}">over</c:if>"><fmt:formatNumber value="${-cat.remaining}" type="currency"/></strong></c:when><c:otherwise><span><c:choose><c:when test="${cat.category eq 'GOALS'}">To your goal</c:when><c:otherwise>Remaining</c:otherwise></c:choose></span><strong><fmt:formatNumber value="${cat.remaining}" type="currency"/></strong></c:otherwise></c:choose></div></section></c:forEach></div>
<div class="two-column workspace"><section class="panel entry-panel"><p class="eyebrow">THE EVERYDAY DETAILS</p><h2>Add an entry</h2><p class="muted">Record an expense or a contribution toward your goals.</p><form class="stack" method="post" action="<c:url value='/transactions'/>"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="formProfileId" value="<c:out value='${summary.profile.id}'/>"><input type="hidden" name="month" value="<c:out value='${month}'/>"><div class="field-pair"><div><label for="date">Date</label><input type="date" id="date" name="date" required min="<c:out value='${monthStart}'/>" max="<c:out value='${monthEnd}'/>" value="<c:out value='${dateInput}'/>"></div><div><label for="category">Category</label><select id="category" name="category" required><option value="NEEDS" <c:if test="${categoryInput eq 'NEEDS'}">selected</c:if>>Needs</option><option value="WANTS" <c:if test="${categoryInput eq 'WANTS'}">selected</c:if>>Wants</option><option value="GOALS" <c:if test="${categoryInput eq 'GOALS'}">selected</c:if>>Goals</option></select></div></div>
<label for="description">Description</label><input id="description" name="description" maxlength="120" required value="<c:out value='${descriptionInput}'/>" placeholder="For example, groceries or savings"><label for="amount">Amount ($)</label><input type="number" id="amount" name="amount" min="0.01" max="999999999.99" step="0.01" required value="<c:out value='${amountInput}'/>" placeholder="0.00"><button type="submit">Save entry</button></form><p class="fine-print">Needs include minimum debt payments. Extra debt repayments belong in goals.</p></section>
<section class="panel entries-panel"><div class="section-heading"><div><p class="eyebrow">SAVED FOR THIS MONTH</p><h2>Your entries</h2></div><span class="entry-count">${summary.budget.transactions.size()} entries</span></div>
<c:choose><c:when test="${empty summary.budget.transactions}"><div class="empty"><span class="empty-icon">+</span><h3>Start with one entry</h3><p>Your expenses and goal contributions will appear here.</p></div></c:when><c:otherwise><div class="table-wrap"><table><caption class="sr-only">Entries for <c:out value="${month}"/></caption><thead><tr><th scope="col">Entry</th><th scope="col">Category</th><th scope="col" class="number">Amount</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead><tbody><c:forEach items="${summary.budget.transactions}" var="entry"><tr><td><strong><c:out value="${entry.description}"/></strong><small><c:out value="${entry.date}"/></small></td><td><span class="tag"><c:out value="${entry.category}"/></span></td><td class="number"><fmt:formatNumber value="${entry.amount}" type="currency"/></td><td><form method="post" action="<c:url value='/transactions/${entry.id}/delete'/>"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="formProfileId" value="<c:out value='${summary.profile.id}'/>"><input type="hidden" name="month" value="<c:out value='${month}'/>"><button class="delete" type="submit" aria-label="Delete <c:out value='${entry.description}'/>">Delete</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<div class="totals"><div><span>Total recorded</span><strong><fmt:formatNumber value="${summary.transactionTotal}" type="currency"/></strong></div><div><span>Income not yet recorded in entries</span><strong class="<c:if test="${summary.unassigned lt 0}">over</c:if>"><fmt:formatNumber value="${summary.unassigned}" type="currency"/></strong></div></div></section></div>
<%@ include file="_bottom.jspf" %>
