<%@ page pageEncoding="UTF-8" %>
<%@ include file="_top.jspf" %>
<section class="intro"><p class="eyebrow">YOUR BUDGET, YOUR SPACE</p><h1>Make room for what matters.</h1><p>Choose a profile to open its monthly planner, or create one to get started.</p></section>
<div class="two-column profile-layout"><section class="panel"><h2>Create a profile</h2><p class="muted">Give your planner a name you recognize.</p><form method="post" action="<c:url value='/profiles'/>" class="stack"><input type="hidden" name="_csrf" value="${csrfToken}"><label for="displayName">Profile name</label><input id="displayName" name="displayName" maxlength="40" required value="<c:out value='${displayNameInput}'/>" placeholder="For example, Demo Ashlie"><button type="submit">Create profile</button></form><p class="fine-print">Profiles keep budgets separate on this computer. Anyone using this app can select a profile.</p></section>
<section class="panel"><h2>Open a saved profile</h2><c:choose><c:when test="${empty profiles}"><div class="empty"><span class="empty-icon">↗</span><h3>A fresh start</h3><p>Create your first profile to begin planning.</p></div></c:when><c:otherwise><div class="profile-list"><c:forEach items="${profiles}" var="profile"><form method="post" action="<c:url value='/profiles/select'/>"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="profileId" value="<c:out value='${profile.id}'/>"><button class="profile-choice" type="submit"><span><c:out value="${profile.displayName}"/></span><span aria-hidden="true">→</span></button></form></c:forEach></div></c:otherwise></c:choose></section></div>
<%@ include file="_bottom.jspf" %>
